// RideTogether — Prisma schema (MVP)
//
// POSTGIS NOTE
// ------------
// PostGIS is enabled through the SQL migration `0000_enable_postgis` via
// `CREATE EXTENSION IF NOT EXISTS postgis`. Prisma does not natively model the
// PostGIS `geography`/`geometry` column types, so we:
//   1. Keep plain `DoublePrecision` lat/lng columns on Trip for the MVP (fast,
//      simple, indexable, and enough for status queries).
//   2. Add the PostGIS `geography(Point, 4326)` column via raw SQL in the
//      migration (see `0000_enable_postgis/migration.sql`), exposed to Prisma
//      as `Unsupported("geography")` so the schema stays in sync without
//      Prisma trying to manage the type.
//
// Future phases (real-time GPS, nearest-rider, group-split, geofencing,
// route tracking) will build PostGIS queries on that geography column using
// ST_DWithin / ST_Distance etc.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A person using RideTogether. Passwords are stored only as bcrypt hashes
/// and never returned by the API.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdTrips Trip[]      @relation("TripCreator")
  memberships  TripMember[]
  refreshTokens RefreshToken[]
  currentLocations CurrentLocation[]
  addedTripSongs TripSong[] @relation("TripSongAddedBy")
  playlists   Playlist[] @relation("PlaylistOwner")
  addedPlaylistSongs PlaylistSong[] @relation("PlaylistSongAddedBy")
  hostedJams JamSession[] @relation("JamHosts")
  jamParticipants JamParticipant[] @relation("JamParticipantUsers")
  tripsDestinationSet Trip[] @relation("TripDestinationSetter")
  navigationSessions NavigationSession[]

  @@index([email])
  @@map("users")
}

/// A group motorcycle trip. Coordinates are stored as double precision for the
/// MVP; the PostGIS geography column is added via raw SQL (see schema header).
model Trip {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  description             String?
  startLocation           String?  @map("start_location")
  destination             String
  startLatitude           Float?   @map("start_latitude") @db.DoublePrecision
  startLongitude          Float?   @map("start_longitude") @db.DoublePrecision
  destinationLatitude     Float?   @map("destination_latitude") @db.DoublePrecision
  destinationLongitude    Float?   @map("destination_longitude") @db.DoublePrecision
  /// PostGIS geography point (SRID 4326) for the destination. Created by raw
  /// SQL in the `0000_enable_postgis` migration; Prisma treats it as opaque.
  destinationGeo           Unsupported("geography")? @map("destination_geo")
  /// Who last set the shared trip destination (null when never set / cleared).
  destinationSetBy         String?  @map("destination_set_by") @db.Uuid
  /// When the shared destination was last set/updated (null when cleared).
  destinationSetAt         DateTime? @map("destination_set_at") @db.Timestamptz(6)
  startDate               DateTime @map("start_date") @db.Timestamptz(6)
  endDate                 DateTime @map("end_date") @db.Timestamptz(6)
  status                  TripStatus @default(PLANNED)
  inviteCode              String   @unique @map("invite_code")
  createdBy               String   @map("created_by") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator     User          @relation("TripCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  destinationSetter User?   @relation("TripDestinationSetter", fields: [destinationSetBy], references: [id], onDelete: SetNull)
  members     TripMember[]
  currentLocations CurrentLocation[]
  tripSongs   TripSong[]
  playlists   Playlist[]
  jams        JamSession[]  @relation("JamTrips")
  navigationSessions NavigationSession[]

  @@index([createdBy])
  @@index([status])
  @@index([startDate])
  @@index([inviteCode])
  @@index([destinationSetBy])
  @@map("trips")
}

/// Membership of a user in a trip. One user appears at most once per trip
/// (unique tripId + userId). OWNER is created automatically with the trip.
model TripMember {
  id       String   @id @default(uuid()) @db.Uuid
  tripId   String   @map("trip_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     MemberRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("trip_members")
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

/// Which navigation context a session belongs to. Group sessions follow the
/// trip's shared destination and are visible to every rider; personal sessions
/// stay private to the rider (only used to restore their own state on reconnect).
enum NavigationMode {
  PERSONAL
  GROUP
}

/// A rider's navigation state within a trip. `ARRIVED` / `GPS_LOST` / `OFFLINE`
/// also drive the group status panel and group ETA derivation.
enum NavigationStatus {
  IDLE
  NAVIGATING
  OFF_ROUTE
  REROUTING
  ARRIVED
  GPS_LOST
  OFFLINE
}

/// Refresh-token session. Only a hash of the token is stored, never the raw
/// token. Tokens are rotated on every use; a rotated (revoked) token that is
/// reused is rejected. All sessions of a user can be revoked at once.
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById  String?   @map("replaced_by_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// The rider's single most-recent location in a trip. Updated via UPSERT on
/// every accepted GPS event — no append-only history in Phase 2. A rider can
/// have at most one current location per trip (unique tripId + userId).
/// PostGIS `location_geo geography(Point, 4326)` is added via raw SQL in the
/// migration so spatial queries (ST_DWithin etc.) work for group-split /
/// nearest-rider features later.
model CurrentLocation {
  id            String   @id @default(uuid()) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  latitude      Float    @db.DoublePrecision
  longitude     Float    @db.DoublePrecision
  accuracy      Float    @db.DoublePrecision
  speed         Float?   @db.DoublePrecision
  heading       Float?   @db.DoublePrecision
  locationGeo   Unsupported("geography")? @map("location_geo")
  /// Client-provided timestamp (validated); used for status derivation.
  lastUpdatedAt DateTime @map("last_updated_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([lastUpdatedAt])
  @@map("current_locations")
}

/// A rider's lightweight navigation session inside a trip. Stores only status
/// transitions, NOT GPS history — the high-frequency signal stays in the
/// socket layer. One row per (trip, user). Group sessions are broadcast to the
/// room; personal sessions are kept only for reconnect recovery.
model NavigationSession {
  id                 String            @id @default(uuid()) @db.Uuid
  tripId             String            @map("trip_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  mode               NavigationMode    @default(GROUP)
  status             NavigationStatus  @default(NAVIGATING)
  /// Destination snapshot at session start (avoids re-deriving on every read).
  destinationLatitude  Float? @map("destination_latitude") @db.DoublePrecision
  destinationLongitude Float? @map("destination_longitude") @db.DoublePrecision
  destinationName      String? @map("destination_name")
  /** Rider-reported remaining distance (m) on the last meaningful update. */
  distanceRemainingMeters Float? @map("distance_remaining_meters") @db.DoublePrecision
  /** Rider-reported projected arrival (epoch ms) on the last meaningful update. */
  etaEpochMs           Float?  @map("eta_epoch_ms") @db.DoublePrecision
  startedAt            DateTime @map("started_at") @db.Timestamptz(6)
  lastUpdatedAt        DateTime @map("last_updated_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([lastUpdatedAt])
  @@map("navigation_sessions")
}

/// A YouTube video tracked as a song. Metadata is shared across every trip —
/// never duplicated per trip. `youtubeVideoId` is unique and can later be
/// passed straight to the official YouTube IFrame Player API.
model Song {
  id              String   @id @default(uuid()) @db.Uuid
  youtubeVideoId  String   @unique @map("youtube_video_id")
  title           String
  channelTitle    String   @map("channel_title")
  thumbnailUrl    String?  @map("thumbnail_url")
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tripSongs TripSong[]
  playlistSongs PlaylistSong[]
  jams      JamSession[] @relation("JamSongs")

  @@index([title])
  @@map("songs")
}

/// A song added to a specific trip's shared music library. One YouTube song
/// can appear at most once per trip (unique tripId + songId).
model TripSong {
  id            String   @id @default(uuid()) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  songId        String   @map("song_id") @db.Uuid
  addedByUserId String   @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  song    Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  addedBy User @relation("TripSongAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@unique([tripId, songId])
  @@index([tripId])
  @@index([songId])
  @@index([addedByUserId])
  @@map("trip_songs")
}

/// A user-owned playlist. It can be a PERSONAL playlist (tripId null) or a
/// TRIP playlist (tripId set, so members can find it inside a trip). Songs
/// are never duplicated — a PlaylistSong only *references* the shared Song
/// row; the unique (playlistId, songId) pair is the final protection against
/// race-condition duplicates.
model Playlist {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tripId      String?  @map("trip_id") @db.Uuid
  name        String
  description String?
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation("PlaylistOwner", fields: [userId], references: [id], onDelete: Cascade)
  trip  Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId])
  @@index([tripId])
  @@map("playlists")
}

/// A song inside a user playlist. `position` is a stable 0-based order kept
/// unique per playlist (see the reorder flow); deleting a PlaylistSong never
/// deletes the Song itself.
model PlaylistSong {
  id            String   @id @default(uuid()) @db.Uuid
  playlistId    String   @map("playlist_id") @db.Uuid
  songId        String   @map("song_id") @db.Uuid
  position      Int
  addedByUserId String   @map("added_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  addedBy  User     @relation("PlaylistSongAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([songId])
  @@index([addedByUserId])
  @@map("playlist_songs")
}

/// Lifecycle of a realtime music Jam session. Only ACTIVE jams are joinable;
/// a deleted/ended jam must never be returned as an active session.
enum JamStatus {
  ACTIVE
  ENDED
  DELETED
}

/// A server-authoritative realtime music session for a trip. The Host is the
/// only member allowed to control playback; every participant follows the
/// state published here. Playback position is captured relative to
/// `positionAt` (server clock) so clients can compute the current position
/// without flooding the network with per-frame updates.
model JamSession {
  id            String    @id @default(uuid()) @db.Uuid
  tripId        String    @map("trip_id") @db.Uuid
  hostUserId    String    @map("host_user_id") @db.Uuid
  currentSongId String?   @map("current_song_id") @db.Uuid
  status        JamStatus @default(ACTIVE)
  isPlaying     Boolean   @default(false) @map("is_playing")
  /// Position (seconds) captured at `positionAt`. The authoritative position
  /// while playing is derived as `position + (serverNow - positionAt) / 1000`.
  position      Float     @default(0) @map("position") @db.DoublePrecision
  positionAt    DateTime  @default(now()) @map("position_at") @db.Timestamptz(6)
  /// Monotonic counter bumped on every authoritative state transition. Clients
  /// drop stale `jam:state` broadcasts with an older version.
  stateVersion  Int       @default(0) @map("state_version")
  /// Host presence heartbeat. Online when `now - hostLastSeenAt` is small.
  hostLastSeenAt DateTime @default(now()) @map("host_last_seen_at") @db.Timestamptz(6)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip         Trip            @relation("JamTrips", fields: [tripId], references: [id], onDelete: Cascade)
  host         User            @relation("JamHosts", fields: [hostUserId], references: [id], onDelete: Cascade)
  currentSong  Song?           @relation("JamSongs", fields: [currentSongId], references: [id], onDelete: SetNull)
  participants JamParticipant[]

  @@index([tripId, status])
  @@index([hostUserId])
  @@map("jam_sessions")
}

/// Membership of a user in a jam session. The host is added on creation and
/// removed when the jam is deleted; participants are re-added on join.
model JamParticipant {
  id           String   @id @default(uuid()) @db.Uuid
  jamSessionId String   @map("jam_session_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  jamSession JamSession @relation(fields: [jamSessionId], references: [id], onDelete: Cascade)
  user       User       @relation("JamParticipantUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jamSessionId, userId])
  @@index([jamSessionId])
  @@index([userId])
  @@map("jam_participants")
}

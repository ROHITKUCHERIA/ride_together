# RideTogether Backend — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL + PostGIS connection string (Prisma uses this).
DATABASE_URL="postgresql://ridetogether:ridetogether@localhost:5433/ridetogether?schema=public"

# JWT signing secrets — generate long random strings (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS — the exact frontend origin (never "*").
FRONTEND_URL="http://localhost:5173"

# Refresh token hash pepper (optional extra secret for hashing refresh tokens).
# If empty, JWT_REFRESH_SECRET is used as the HMAC key.
REFRESH_HASH_PEPPER=""

# Realtime GPS (Socket.IO)
# Minimum interval between accepted location updates per rider (ms).
LOCATION_UPDATE_MIN_INTERVAL_MS=3000
# Rider status thresholds, derived from lastUpdatedAt age (ms).
RIDER_LIVE_THRESHOLD_MS=15000
RIDER_DELAYED_THRESHOLD_MS=60000
# Reject client timestamps older than / further in the future than these (ms).
LOCATION_MAX_AGE_MS=300000
LOCATION_MAX_FUTURE_MS=30000

# YouTube Music (Phase 3A)
# Official YouTube Data API v3 key. Backend-only — NEVER expose via VITE_*.
YOUTUBE_API_KEY=""
# Search result cache duration (ms) — protects YouTube quota for repeat queries.
YOUTUBE_SEARCH_CACHE_TTL_MS=900000
# Results per search page (1-50).
YOUTUBE_SEARCH_MAX_RESULTS=10
# Soft cap on search query length.
YOUTUBE_SEARCH_MAX_QUERY_LENGTH=200

# Navigation / routing (Phase 1)
# Routing engine provider + base URL. osrm is the only provider implemented.
# Point ROUTING_API_URL at a self-hosted OSRM/GraphHopper server to move off the
# public endpoint. Any key stays server-side — never expose via VITE_*.
ROUTING_PROVIDER=osrm
ROUTING_API_URL="https://router.project-osrm.org"
ROUTING_TIMEOUT_MS=10000

# Phase 2: normalized route cache lifetime (s). Same origin/destination within
# this window is served from memory without a second OSRM request.
NAVIGATION_ROUTE_CACHE_TTL_SECONDS=300

# Phase 2: per-user/IP rate limits for the navigation endpoints (protects the
# routing engine from accidental reroute loops / search spam). Values may be
# zero to tighten, or raised for high-traffic deployments.
NAVIGATION_ROUTE_THROTTLE_TTL_MS=60000
NAVIGATION_ROUTE_THROTTLE_LIMIT=20
NAVIGATION_GEOCODE_THROTTLE_TTL_MS=60000
NAVIGATION_GEOCODE_THROTTLE_LIMIT=30

# Place search (geocoding) provider + base URL (OSM Nominatim).
GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL="https://nominatim.openstreetmap.org"
GEOCODING_TIMEOUT_MS=10000

# Phase 3 — shared group navigation
# ---------------------------------------------------------------------------
# Distributed route cache + reroute cooldown. When REDIS_URL is empty the API
# transparently falls back to in-memory stores (single-instance dev only).
# Set REDIS_URL="redis://localhost:6379" in production.
REDIS_URL=""

# Minimum gap between accepted navigation-status updates per rider (ms).
NAVIGATION_STATUS_MIN_INTERVAL_MS=5000
# Distributed reroute cooldown (s) — how long a rider's reroute lock is held.
NAVIGATION_REROUTE_COOLDOWN_SECONDS=15

# Per-user/IP rate limits (shared `navigation` throttle scorer).
NAVIGATION_STATUS_THROTTLE_TTL_MS=60000
NAVIGATION_STATUS_THROTTLE_LIMIT=60
NAVIGATION_DESTINATION_THROTTLE_TTL_MS=60000
NAVIGATION_DESTINATION_THROTTLE_LIMIT=30

# Sessions whose last update is older than this (ms) are surfaced as stale in
# the group snapshot (derivation, not a store in itself).
NAVIGATION_SESSION_STALE_AFTER_MS=1800000

# RideTogether Backend — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL + PostGIS connection string (Prisma uses this).
DATABASE_URL="postgresql://ridetogether:ridetogether@localhost:5433/ridetogether?schema=public"

# JWT signing secrets — generate long random strings (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS — the exact frontend origin (never "*").
FRONTEND_URL="http://localhost:5173"

# Refresh token hash pepper (optional extra secret for hashing refresh tokens).
# If empty, JWT_REFRESH_SECRET is used as the HMAC key.
REFRESH_HASH_PEPPER=""

# Realtime GPS (Socket.IO)
# Minimum interval between accepted location updates per rider (ms).
LOCATION_UPDATE_MIN_INTERVAL_MS=3000
# Rider status thresholds, derived from lastUpdatedAt age (ms).
RIDER_LIVE_THRESHOLD_MS=15000
RIDER_DELAYED_THRESHOLD_MS=60000
# Reject client timestamps older than / further in the future than these (ms).
LOCATION_MAX_AGE_MS=300000
LOCATION_MAX_FUTURE_MS=30000

# YouTube Music (Phase 3A)
# Official YouTube Data API v3 key. Backend-only — NEVER expose via VITE_*.
YOUTUBE_API_KEY=""
# Search result cache duration (ms) — protects YouTube quota for repeat queries.
YOUTUBE_SEARCH_CACHE_TTL_MS=900000
# Results per search page (1-50).
YOUTUBE_SEARCH_MAX_RESULTS=10
# Soft cap on search query length.
YOUTUBE_SEARCH_MAX_QUERY_LENGTH=200

# RideTogether Frontend — environment configuration
# Copy to .env and adjust. Only VITE_-prefixed variables reach the browser.
# NEVER put secrets here (backend-only values live in backend/.env).

# ---------- backend realtime integration (live map) ----------

# Base URL of the NestJS backend (REST + Socket.IO share this origin).
VITE_API_URL="http://localhost:3000"
# When "true" the live map talks to the backend over Socket.IO instead of the
# in-browser mock. Requires the backend + demo user (see prisma/seed.ts).
VITE_USE_REALTIME_BACKEND=false
# Optional explicit trip id; when empty the first joined trip is used.
VITE_BACKEND_TRIP_ID=""
# Optional pre-issued access token; when empty a demo user is logged in.
VITE_ACCESS_TOKEN=""
VITE_DEV_EMAIL="demo@ridetogether.app"
VITE_DEV_PASSWORD="Demo1234!"

# Client-side GPS throttle (ms between accepted fixes, min movement).
VITE_LOCATION_UPDATE_INTERVAL_MS=5000
VITE_MIN_DISTANCE_METERS=10
VITE_MIN_ACCURACY_METERS=100
VITE_GPS_TIMEOUT_MS=15000
VITE_GPS_MAXIMUM_AGE_MS=0

# Rider presence bands (ms): 0–live LIVE, live–delayed DELAYED, else STALE/offline.
VITE_PRESENCE_LIVE_MS=15000
VITE_PRESENCE_DELAYED_MS=60000
VITE_PRESENCE_STALE_MS=90000

# Group metrics.
VITE_GROUP_SPREADING_THRESHOLD_METERS=2000
VITE_GROUP_SPLIT_THRESHOLD_METERS=3000

# Mock realtime (only used when VITE_USE_REALTIME_BACKEND is false).
VITE_MOCK_RIDER_TICK_MS=2000

# ---------- navigation (Phase 1: routing + geocoding) ----------

# Direct OSRM fallback used when there is no backend session. Point at any
# OSRM server (self-hosted or commercial) to replace the public router.
VITE_OSRM_URL="https://router.project-osrm.org"
# Straight-line fallback geocoder (OSM Nominatim).
VITE_NOMINATIM_URL="https://nominatim.openstreetmap.org"

# ---------- navigation (Phase 2: turn-by-turn) ----------

# Arrival reached within this distance of the destination (m).
VITE_NAV_ARRIVAL_THRESHOLD_METERS=50
# Considered off-route when farther than this from the route line (m).
VITE_NAV_OFF_ROUTE_THRESHOLD_METERS=150
# Zoom level used by the Recenter button while navigating.
VITE_NAV_RECENTER_ZOOM=15
# Zoom fallback for single-rider tile set.
VITE_NAV_SINGLE_RIDER_ZOOM=14
# Debounce for the destination search input (ms).
VITE_NAV_SEARCH_DEBOUNCE_MS=400

# Voice is spoken once when the maneuver is within these distances (m):
VITE_NAV_MANEUVER_FAR_THRESHOLD_METERS=500
VITE_NAV_MANEUVER_NEAR_THRESHOLD_METERS=100
# A maneuver counts as completed within this distance of its location (m).
VITE_NAV_MANEUVER_COMPLETION_THRESHOLD_METERS=40

# Automatic rerouting.
VITE_NAV_AUTO_REROUTE_ENABLED=true
# Minimum time off-route before a reroute may fire (ms).
VITE_NAV_AUTO_REROUTE_DELAY_MS=3000
# Minimum interval between two reroutes (ms).
VITE_NAV_AUTO_REROUTE_MIN_INTERVAL_MS=15000
# Consecutive off-route GPS samples required to confirm the deviation.
VITE_NAV_OFF_ROUTE_CONFIRMATION_SAMPLES=3
# Accuracy-aware off-route: effective threshold adds accuracy, capped here (m).
VITE_NAV_OFF_ROUTE_MAX_ACCURACY_METERS=200

# GPS quality bands (m).
VITE_NAV_GPS_POOR_ACCURACY_METERS=250
# Rider marker treated as lost when no live fix is newer than this (ms).
VITE_NAV_GPS_SIGNAL_LOST_AFTER_MS=20000

# Voice guidance via the Web Speech API (default on; set to false to disable).
VITE_NAV_VOICE_ENABLED=true
# Client-side route cache lifetime (ms) per origin/destination pair.
VITE_NAV_ROUTE_CACHE_TTL_MS=300000
# Maximum heading rotation applied per update when smoothing (deg).
VITE_NAV_HEADING_MAX_STEP_DEG=18